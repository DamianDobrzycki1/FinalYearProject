{
    "name": "Pi + ESP32 Dev",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "ghcr.io/devcontainers/features/python:1":{}
    },
    "postCreateCommand": "curl -fsSL https://tailscale.com/install.sh | sh && sudo apt-get update && sudo apt-get install -y netcat-openbsd",
    "postStartCommand": "sudo nohup tailscaled --tun=userspace-networking --socks5-server=localhost:1055 > /tmp/tailscaled.log 2>&1 &",
    "customizations": {
    "vscode": {
      "extensions": [
        "platformio.platformio-ide",
        "platformio.platformio-ide"
      ]
    }
  }
}